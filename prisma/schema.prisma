// Local-business outreach pipeline — data model.
// SQLite has no native enums; "enum-like" fields are documented strings.
// Run migrations with: npm run db:migrate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A discovered local business, scored into an outreach tier.
model Lead {
  id                  String   @id @default(cuid())
  placeId             String   @unique // Google Places place_id (or source-prefixed id)
  source              String   @default("google") // which LeadSource produced this

  name                String
  address             String?
  phone               String?
  email               String?  // contact email extracted from the business's own site/social
  website             String?
  rating              Float?
  reviewCount         Int      @default(0)
  photoCount          Int      @default(0)

  // Qualification ---------------------------------------------------------
  tier                String   @default("COLD") // HOT | WARM | COLD
  score               Int      @default(0)
  qualificationReason String?
  signals             String?  // JSON: raw signal map used to compute the tier

  // Artifacts -------------------------------------------------------------
  previewImagePath    String?  // /previews/{placeId}.png once generated
  // The same render captured at a 390x844 phone viewport. Null for previews
  // generated before this existed, and for renders whose phone shot failed.
  previewMobileImagePath String?
  previewHtmlPath     String?
  previewEngine       String?  // "ai" | "template" — which engine actually produced the stored HTML.
                               // Recorded because the AI path degrades to the template on any failure,
                               // and without this a failed design is indistinguishable from a real one.
  previewVariant      Int      @default(0) // bumped to re-roll the seeded art direction on regeneration
  deployedUrl         String?  // the live hosting URL (e.g. *.vercel.app) after deploy
  customDomain        String?  // a real domain attached to the deployed site, when configured

  // Funnel ----------------------------------------------------------------
  // discovered -> preview_ready -> drafted -> approved -> sent -> interested
  //   -> customer -> deployed   (or -> lost at any point)
  status              String   @default("discovered")

  // Engagement (public /p/ preview) ---------------------------------------
  previewViews        Int      @default(0)  // times the public preview was opened
  firstViewedAt       DateTime?
  lastViewedAt        DateTime?
  interestedAt        DateTime?             // prospect clicked "I'm interested" on the demo
  repliedAt           DateTime?             // operator marked the prospect replied — pauses the follow-up sequence

  // Portfolio -------------------------------------------------------------
  // Hand-picked for the public /examples page. A flag rather than a curated id
  // list in config, because ids are cuids minted at discovery — a config file
  // would mean a rebuild every time the portfolio changes.
  showcase            Boolean  @default(false)

  // Billing (Stripe) ------------------------------------------------------
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?              // active | trialing | past_due | canceled

  searchRunId         String?
  searchRun           SearchRun? @relation(fields: [searchRunId], references: [id])
  outreach            Outreach[]
  siteMessages        SiteMessage[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tier])
  @@index([status])
  @@index([showcase])
}

/// A drafted outreach message awaiting manual review + send. Never auto-sent.
model Outreach {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel   String   @default("email") // email | whatsapp | phone | manual
  contact   String?  // resolved contact handle (email/phone), if any
  subject   String?
  body      String

  // 0 = initial message; 1..n = follow-ups in the sequence (sent later if no reply).
  step      Int      @default(0)

  status    String   @default("draft") // draft | approved | queued | sent | skipped
  // When a queued follow-up becomes due to send. Set when the prior step is sent;
  // the follow-up "due" queue surfaces queued rows whose scheduledAt has passed.
  scheduledAt DateTime?
  sentAt    DateTime?
  // Stamped when the operator ticked off the pre-send checklist (business name,
  // phone, address, hours, no hallucinations, mobile, contact form, preview
  // loads) and approved. Approval requires it — a broken generated site is far
  // more expensive to send than 30 seconds of checking is to spend.
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
}

/// A discovery run, so past searches and their counts are visible.
model SearchRun {
  id          String   @id @default(cuid())
  query       String
  location    String
  status      String   @default("running") // running | done | error
  error       String?

  totalFound  Int      @default(0) // raw places returned by search
  newLeads    Int      @default(0) // places not previously in DB
  cachedHits  Int      @default(0) // place details served from cache
  detailCalls Int      @default(0) // Place Details API calls actually billed

  leads       Lead[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Raw API response cache, keyed by placeId. Never re-fetch a cached place.
model PlaceCache {
  placeId   String   @id
  source    String   @default("google")
  raw       String   // raw JSON response for this place
  // BCP-47 language this snapshot was fetched in (GOOGLE_PLACES_LANGUAGE at the
  // time). Part of the cache identity: Google localizes review text, weekday
  // descriptions and category labels, so a snapshot taken under a different
  // language is stale even though the placeId matches. Null = fetched before
  // this was tracked, i.e. unknown (in practice English).
  language  String?
  createdAt DateTime @default(now())
}

/// A message submitted through the contact form on a deployed customer site.
/// The deployed HTML is static, so its form posts back to THIS app; each submission
/// is stored here and (best-effort) emailed to the site owner.
model SiteMessage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  name      String?
  email     String?
  phone     String?
  message   String

  notified  Boolean  @default(false) // whether we managed to email the owner
  readAt    DateTime?                // operator opened it in the inbox
  createdAt DateTime @default(now())

  @@index([leadId])
}

/// One billable Claude API call (preview generation, outreach drafting), with
/// token counts and the computed USD cost — powers the unit-economics dashboard.
model AiUsage {
  id           String   @id @default(cuid())
  purpose      String   // preview_vision | preview_reviews | preview_design | outreach_draft
  model        String
  placeId      String?  // which lead the spend belongs to (joins Lead.placeId)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([purpose])
  @@index([placeId])
  @@index([createdAt])
}

/// Per-SKU API call counter (one row per SKU per UTC day) for cost tracking.
model ApiUsage {
  id    String @id @default(cuid())
  sku   String // TEXT_SEARCH | PLACE_DETAILS
  day   String // YYYY-MM-DD (UTC)
  count Int    @default(0)

  @@unique([sku, day])
  @@index([sku])
}
