# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is git-ignored and is the ONLY place secrets should live.
# Every key below is read server-side only and never shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────

# --- Database -------------------------------------------------------------
# SQLite file, relative to the project root. No external DB to manage.
DATABASE_URL="file:./dev.db"

# --- Lead source ----------------------------------------------------------
# Which LeadSource implementation to use: "google" | "mock"
# "mock" needs no API key and returns sample data — use it to try the UI
# before spending on Google, or to validate the qualifier offline.
LEAD_SOURCE="mock"

# Google Places API (New). Required only when LEAD_SOURCE="google".
# Create at https://console.cloud.google.com/ → enable "Places API (New)".
GOOGLE_PLACES_API_KEY=""

# --- Cost safety stops ----------------------------------------------------
# Hard daily ceiling on the EXPENSIVE call (Place Details), enforced in code
# as a backstop independent of the QPD cap you should ALSO set in the GCP
# console. Discovery stops fetching details once this is hit for the day.
MAX_DETAILS_PER_DAY="200"
# Ceiling on Text Search calls per day (cheaper Pro-tier SKU).
MAX_SEARCH_PER_DAY="100"

# MONTHLY free-tier guards — the real $0 failsafe. Google's free allowance is
# per-SKU PER MONTH, so the daily caps above can't guarantee it on their own.
# Discovery stops calling a SKU for the rest of the (UTC) month once its guard is
# hit. Defaults sit just under the current free caps with a safety margin:
#   Place Details = Enterprise SKU, ~1,000 free/mo  -> guard 950
#   Text Search   = Pro SKU,        ~5,000 free/mo  -> guard 4800
# Set these LOWER if you also want a tighter personal cap (e.g. 30 details/mo).
MAX_DETAILS_PER_MONTH="950"
MAX_SEARCH_PER_MONTH="4800"

# Free monthly allowance estimates, used only to render "% of free tier used"
# in the dashboard. THESE ARE NOT AUTHORITATIVE — Google restructures pricing
# often (the old shared $200/mo credit was replaced by per-SKU allowances in
# March 2025). Check live pricing: https://mapsplatform.google.com/pricing/
FREE_TIER_TEXT_SEARCH_PER_MONTH="5000"
FREE_TIER_PLACE_DETAILS_PER_MONTH="1000"

# --- Site analysis --------------------------------------------------------
# Timeout (ms) for fetching a lead's existing website during qualification.
# Kept short so one slow/dead site never stalls a discovery batch.
SITE_FETCH_TIMEOUT_MS="6000"

# --- Preview / deploy (used in later build phases) ------------------------
# Deploy target for the opt-in deploy step: "vercel" | "cloudflare"
DEPLOY_TARGET="vercel"
VERCEL_TOKEN=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
