# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is git-ignored and is the ONLY place secrets should live.
# Every key below is read server-side only and never shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────

# --- Database -------------------------------------------------------------
# SQLite file, relative to the project root. No external DB to manage.
DATABASE_URL="file:./dev.db"

# --- Lead source ----------------------------------------------------------
# Which LeadSource implementation to use: "google" | "mock"
# "mock" needs no API key and returns sample data — use it to try the UI
# before spending on Google, or to validate the qualifier offline.
LEAD_SOURCE="mock"

# Google Places API (New). Required only when LEAD_SOURCE="google".
# Create at https://console.cloud.google.com/ → enable "Places API (New)".
GOOGLE_PLACES_API_KEY=""

# BCP-47 language for Google Places responses, e.g. "sl" for Slovenia.
# Leave empty and Google answers in ENGLISH: reviews come back machine-translated,
# opening hours read "Monday: 6:00 AM – 7:00 PM" and categories read "Hair Salon".
# Those strings are used verbatim on the generated site, so on a non-English market
# set this to the local language. Review text is always taken from Google's
# `originalText` regardless, so quotes stay in the words the reviewer wrote.
# Changing this only affects NEW fetches — use "Refresh details" on a lead to
# re-pull an already-cached place.
GOOGLE_PLACES_LANGUAGE=""

# --- Unit economics --------------------------------------------------------
# What one customer pays per month (the €50 in the pitch). The analytics page
# multiplies this by active subscriptions to show MRR and month profit. Claude
# API spend is tracked automatically per call (AiUsage table) — no config needed.
MONTHLY_PRICE_EUR="50"

# --- Cost safety stops ----------------------------------------------------
# Hard daily ceiling on the EXPENSIVE call (Place Details), enforced in code
# as a backstop independent of the QPD cap you should ALSO set in the GCP
# console. Discovery stops fetching details once this is hit for the day.
MAX_DETAILS_PER_DAY="200"
# Ceiling on Text Search calls per day (cheaper Pro-tier SKU).
MAX_SEARCH_PER_DAY="100"
# Place Photos is its OWN billable SKU, fetched lazily when you generate a preview
# (never during discovery). PREVIEW_PHOTO_COUNT photos are pulled per preview and
# cached on disk, so regenerating the same lead never re-bills.
MAX_PHOTOS_PER_DAY="80"
PREVIEW_PHOTO_COUNT="4"
# A real static map of the business location is added to the preview's contact
# section (its OWN billable SKU — Maps Static API). Like photos it's fetched lazily,
# inlined as a data URI (the API key never ships in the HTML), and cached on disk.
# Set PREVIEW_MAP="off" to disable. Requires the Maps Static API enabled on the key.
PREVIEW_MAP="on"
MAX_STATIC_MAPS_PER_DAY="80"

# MONTHLY free-tier guards — the real $0 failsafe. Google's free allowance is
# per-SKU PER MONTH, so the daily caps above can't guarantee it on their own.
# Discovery stops calling a SKU for the rest of the (UTC) month once its guard is
# hit. Defaults sit just under the current free caps with a safety margin:
#   Place Details = Enterprise SKU, ~1,000 free/mo  -> guard 950
#   Text Search   = Pro SKU,        ~5,000 free/mo  -> guard 4800
# Set these LOWER if you also want a tighter personal cap (e.g. 30 details/mo).
MAX_DETAILS_PER_MONTH="950"
MAX_SEARCH_PER_MONTH="4800"
#   Place Photos = ~5,000 free/mo (per recent pricing) -> guard 4800
MAX_PHOTOS_PER_MONTH="4800"
#   Maps Static = ~10,000 free/mo (per recent pricing) -> guard 9000
MAX_STATIC_MAPS_PER_MONTH="9000"

# Free monthly allowance estimates, used only to render "% of free tier used"
# in the dashboard. THESE ARE NOT AUTHORITATIVE — Google restructures pricing
# often (the old shared $200/mo credit was replaced by per-SKU allowances in
# March 2025). Check live pricing: https://mapsplatform.google.com/pricing/
FREE_TIER_TEXT_SEARCH_PER_MONTH="5000"
FREE_TIER_PLACE_DETAILS_PER_MONTH="1000"
FREE_TIER_PLACE_PHOTOS_PER_MONTH="5000"
FREE_TIER_STATIC_MAPS_PER_MONTH="10000"

# --- Site analysis --------------------------------------------------------
# Timeout (ms) for fetching a lead's existing website during qualification.
# Kept short so one slow/dead site never stalls a discovery batch.
SITE_FETCH_TIMEOUT_MS="6000"

# --- Outreach drafting (Claude) -------------------------------------------
# Optional. When set, outreach drafts are written by Claude in the business's own
# language (e.g. Slovene), naming the specific gap and linking the live preview.
# Without a key, drafts fall back to the deterministic English template — the app
# still works, just less personalized. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Model used for drafting AND for the bespoke site engine. Default is the current
# Opus, which is notably stronger at UI/frontend design work than 4.8 at the same
# $5/$25 per MTok. Switch to a cheaper model (e.g. "claude-haiku-4-5") to cut
# per-lead cost on large batches (much lower design quality).
ANTHROPIC_MODEL="claude-opus-5"

# Preview engine: "ai" = Claude designs a unique site per business (best quality,
# costs ~one LLM call per preview); "template" = free deterministic generator.
# Leave empty to auto-pick: "ai" when ANTHROPIC_API_KEY is set, else "template".
# NOTE: "Regenerate all previews" with engine=ai bills one call per lead.
PREVIEW_ENGINE=""

# Public base URL of THIS app, used to build the shareable preview link dropped
# into outreach (e.g. https://your-app.example.com/p/<leadId>). Defaults to local.
APP_BASE_URL="http://localhost:3000"

# --- Owner bar (public preview CTA) ---------------------------------------
# The public preview at /p/<leadId> shows a dismissible bar that lets a prospect
# tap "I'm interested" (recorded as a warm signal) and reach you directly. Fill in
# at least one contact so the bar can reveal how to reach you. Set OWNER_BAR="off"
# to hide the bar entirely. The bar is NEVER baked into the outreach screenshot.
OWNER_BAR="on"
OUTREACH_OWNER_NAME=""
OUTREACH_OWNER_EMAIL=""
OUTREACH_OWNER_PHONE=""
OUTREACH_OWNER_BOOKING_URL=""

# --- Follow-ups -----------------------------------------------------------
# Drafting produces a 3-message sequence (initial + 2 follow-ups). After the
# initial is sent, each follow-up becomes "due" this many days after the previous
# message — and only while the prospect hasn't replied / shown interest. The
# "Follow-ups" page is the due queue; nothing is sent without you clicking send.
FOLLOWUP_INTERVAL_DAYS="3"

# Hands-off delivery of DUE follow-ups (email only; needs SMTP below). Initial
# messages always stay manual — you approve and send the first touch, then the
# rest of the sequence runs itself, still auto-pausing the moment the prospect
# replies or clicks "interested". DM/phone follow-ups stay in the manual queue.
AUTO_SEND_FOLLOWUPS="off"
AUTO_SEND_INTERVAL_MIN="60"

# --- Sending email (optional) ---------------------------------------------
# When set, an approved draft (and due follow-ups) can be SENT from the app with
# the preview image attached, instead of copy-pasting into Gmail. Leave SMTP_HOST
# empty to keep the manual flow: "Send" then opens a prefilled Gmail compose tab.
# For a Gmail account: create an App Password (Google Account → Security →
# 2-Step Verification → App passwords) and use it as SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=on
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="on"
SMTP_USER=""
SMTP_PASS=""
# From header; defaults to SMTP_USER. "Your Name <you@gmail.com>" is allowed.
SMTP_FROM=""

# --- Preview / deploy (used in later build phases) ------------------------
# Deploy target for the opt-in deploy step: "vercel" | "cloudflare"
DEPLOY_TARGET="vercel"
VERCEL_TOKEN=""
# Optional: scope deploys + custom domains to a Vercel team.
VERCEL_TEAM_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# --- Stripe billing (turn an interested lead into a paying customer) ------
# Optional. Without STRIPE_SECRET_KEY the "Payment link" action is simply off and
# the rest of the app is unaffected. Stripe has no monthly fee — it only takes a
# per-transaction cut on money you actually collect.
#   STRIPE_PRICE_ID        = your recurring €50/mo Price (create it in the Stripe
#                            dashboard → Products). Tip: offer SEPA Direct Debit as a
#                            payment method there — cheaper recurring fees in the EU.
#   STRIPE_BUYOUT_PRICE_ID = optional one-time buyout Price (for owners who'd rather
#                            pay once than subscribe).
#   STRIPE_WEBHOOK_SECRET  = signing secret of a webhook endpoint pointed at
#                            <APP_BASE_URL>/api/stripe/webhook, subscribed to
#                            checkout.session.completed + customer.subscription.updated/deleted.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_BUYOUT_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
